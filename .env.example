# Общие
ENV=dev
SECRET_KEY=please-change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=1209600
COOKIE_NAME=ordo_session
# true в продакшене (сайт работает по HTTPS)
COOKIE_SECURE=false
# Домен(ы) веба для CORS, через запятую. В проде — ваш публичный домен,
# например https://ordo.example.com
WEB_ORIGIN=http://localhost:3000

# База данных
DATABASE_URL=postgresql+asyncpg://ordo:ordo@postgres:5432/ordo
POSTGRES_USER=ordo
POSTGRES_PASSWORD=ordo
POSTGRES_DB=ordo

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ordo-files
S3_REGION=us-east-1
MAX_UPLOAD_MB=50

# ИИ-шлюз: Kimi (Moonshot AI)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# ИИ-шлюз: Qwen (Alibaba DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_VL_MODEL=qwen3-vl-plus

# Собственный vLLM-сервер (OpenAI-совместимый)
SELFHOST_BASE_URL=
SELFHOST_MODEL=

AI_ROUTING=config/ai_routing.yaml
# ru — только selfhost для запросов с пользовательскими данными; dev — разрешены облачные kimi/qwen
DATA_RESIDENCY=ru

GOOGLE_CALENDAR_ENABLED=false

RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_AI=30/minute

# Веб
NEXT_PUBLIC_API_URL=http://localhost:8000

# Продакшен: домены для Caddy (docker-compose.prod.yml) и автоматического TLS.
# Оба должны A-записью указывать на IP сервера. В проде также задайте
# NEXT_PUBLIC_API_URL=https://<API_DOMAIN> и WEB_ORIGIN=https://<WEB_DOMAIN>
# и COOKIE_SECURE=true выше.
WEB_DOMAIN=ordo.example.com
API_DOMAIN=api.ordo.example.com
